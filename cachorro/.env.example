# Copia este archivo a .env y rellénalo. Sin STRIPE_SECRET_KEY el servidor arranca en modo demo.
PORT=3000
BASE_URL=http://localhost:3000
MARCA=Plan Cachorro
EMAIL_CONTACTO=hola@tudominio.es
TITULAR=Razón social, NIF y dirección

# Stripe: usa primero las claves de test (sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Meta Pixel (solo se carga si el visitante acepta las cookies)
META_PIXEL_ID=

# Precios en céntimos. Fase 1a: 1999. Fase 1b: 1999,2499
PRECIOS=1999
PRECIO_UPSELL=999

# Token para GET /api/admin/metricas?token=...
ADMIN_TOKEN=
