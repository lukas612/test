# Copia este archivo a .env. Sin claves, todo funciona en local: datos en data/, pagos simulados y emails desactivados.
PORT=3000
BASE_URL=http://localhost:3000
MARCA=Plan Cachorro
EMAIL_CONTACTO=hola@tudominio.es
TITULAR=Razón social, NIF y dirección

# Supabase: el mismo proyecto que Vigila (tablas pc_*). La service_role key está en
# supabase.com/dashboard/project/wwxlzvfxlfuodikcamlq/settings/api — nunca en el navegador.
SUPABASE_URL=https://wwxlzvfxlfuodikcamlq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stripe: la misma cuenta que Vigila. Webhook propio en https://TU-DOMINIO/api/webhook
# (eventos checkout.session.completed y charge.refunded); el servidor ignora lo que no es del cachorro.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend: la misma cuenta que Vigila, pero con el dominio del cachorro verificado.
RESEND_API_KEY=
EMAIL_FROM=Plan Cachorro <hola@tudominio.es>
EMAIL_REPLY_TO=hola@tudominio.es

# Meta Pixel (solo se carga si el visitante acepta cookies)
META_PIXEL_ID=

# Precios en céntimos. Fase 1a: 1999. Fase 1b: 1999,2499
PRECIOS=1999
PRECIO_UPSELL=999

# Acceso al panel /admin.html y firma de los enlaces de baja. Pon valores largos y aleatorios.
ADMIN_TOKEN=
APP_SECRET=
